# Discord Bot Settings
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here

# Database Settings (Supabase / PostgreSQL)
# Doumori Bot専用 Supabase DB
DOUMORI_DATABASE_URL=postgresql://postgres.doumori:password@aws-0-region.pooler.supabase.com:6543/postgres

# Manybot専用 Supabase DB (通貨連携用)
MANYBOT_DATABASE_URL=postgresql://postgres.manybot:password@aws-0-region.pooler.supabase.com:6543/postgres

# Render Port (Optional)
PORT=8080
