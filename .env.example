# Discord Bot Settings
# ManyBot と同じトークン・クライアントIDを設定する（同じアプリで動かす）
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here

# Database Settings (Supabase / PostgreSQL)
# ManyBot のマスターDB（ManyBot の DATABASE_URL と同じ）。
# ManyBot ダッシュボードの「データベース設定」で登録したサーバー専用DBを、サーバーごとに使う
MANYBOT_DATABASE_URL=postgresql://postgres.manybot:password@aws-0-region.pooler.supabase.com:6543/postgres

# Optional: 旧どう森DB（サーバー専用DBが登録されていないサーバーで使う）
# DOUMORI_DATABASE_URL=postgresql://postgres.doumori:password@aws-0-region.pooler.supabase.com:6543/postgres

# Optional: ヘルスチェック用Webサーバーのポート
# VPS + pm2 運用では不要（設定しなければ起動しない）。Render等では自動設定される。
# PORT=8080

# Optional: どう森の機能を動かすサーバー(Guild) ID（カンマ区切りで複数可）。ManyBot と同じ値にする
# DOUMORI_GUILD_ID=1526696870724894780
