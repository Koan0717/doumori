# どう森BOT本体と同じDBに接続します
DOUMORI_DATABASE_URL=postgresql://postgres.doumori:password@aws-0-region.pooler.supabase.com:6543/postgres

# どう森BOT本体と同じトークン（チャンネル/ロール取得・パネル送信に使用）
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# このダッシュボードが管理する対象サーバーのGuild ID
DASHBOARD_GUILD_ID=your_discord_guild_id_here

# ダッシュボードのログイン情報
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_me
JWT_SECRET=any_random_secret_string
